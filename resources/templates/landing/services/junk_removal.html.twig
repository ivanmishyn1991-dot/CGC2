{% extends "page.html.twig" %}

{% block title %}Junk Removal in Metro Vancouver BC | Clean Gutters Crew{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://cgc-services.ca/services/junk_removal#webpage",
      "url": "https://cgc-services.ca/services/junk_removal",
      "name": "Junk Removal in Metro Vancouver BC | Clean Gutters Crew",
      "isPartOf": {"@id": "https://cgc-services.ca/#website"},
      "about": {"@id": "https://cgc-services.ca/#business"},
      "description": "Junk removal services in Metro Vancouver for clutter, yard waste, household items, debris, and responsible disposal.",
      "breadcrumb": {"@id": "https://cgc-services.ca/services/junk_removal#breadcrumb"},
      "inLanguage": "en-CA"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://cgc-services.ca/services/junk_removal#breadcrumb",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://cgc-services.ca/"},
        {"@type": "ListItem", "position": 2, "name": "Junk Removal", "item": "https://cgc-services.ca/services/junk_removal"}
      ]
    },
    {
      "@type": "Service",
      "@id": "https://cgc-services.ca/services/junk_removal#service",
      "name": "Junk Removal",
      "serviceType": "Junk Removal",
      "url": "https://cgc-services.ca/services/junk_removal",
      "provider": {"@id": "https://cgc-services.ca/#business"},
      "areaServed": {"@type": "AdministrativeArea", "name": "Metro Vancouver"},
      "description": "Junk removal services in Metro Vancouver for yard waste, household items, old furniture, debris, and responsible disposal."
    }
  ]
